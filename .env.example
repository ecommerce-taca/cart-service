# Application
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# MongoDB
MONGODB_URI=mongodb://localhost:27017/cartdb?replicaSet=rs0&directConnection=true

# Product
PRODUCT_TIMEOUT=2s
PRODUCT_CACHE_TTL=30s
PRODUCT_MAX_CONCURRENCY=10

# Cart
CART_HYDRATE_TIMEOUT=3s
CART_IDEMPOTENCY_TTL=24h
CART_WRITE_RETRY_MAX=3

# Internal authentication 
# CART_INTERNAL_TOKEN=

# CART_GATEWAY_TOKEN=<64-character-random-hex-token>

# Internal service authentication
# Generate a random 32-byte secret, encoded as 64 hex characters
# CART_INTERNAL_TOKEN=

# Product Catalog
PRODUCT_BASE_URL=
PRODUCT_TIMEOUT=2s